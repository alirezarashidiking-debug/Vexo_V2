{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },
    "usernames": {
      ".read": false,
      ".write": false
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "transactions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": false
      }
    },
    "system": {
      ".read": false,
      ".write": false
    },
    "matchmaking": {
      ".read": false,
      ".write": false
    },
    "matches": {
      "$matchId": {
        ".read": "auth != null && data.child('players').child(auth.uid).val() === true",
        ".write": false
      },
      ".indexOn": [
        "createdAt"
      ]
    }
  }
}